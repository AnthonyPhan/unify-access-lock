# The service can start with no .env file. Open http://<raspberry-pi>:8080 and
# complete setup in the web app. These boot settings are optional.
SETUP_PORT=8080
CONFIG_PATH=./data/config.json

# Optional headless/bootstrap configuration. Values saved in the web app are
# stored in CONFIG_PATH and take precedence over these values.
# UniFi Access API (the API server normally listens on HTTPS port 12445).
UNIFI_ACCESS_URL=https://192.168.1.1:12445
UNIFI_API_TOKEN=replace-me

# The stock UniFi Access API certificate is self-signed. Prefer installing a
# trusted certificate; otherwise set this to false on a trusted management LAN.
UNIFI_TLS_REJECT_UNAUTHORIZED=false

# The URL must be reachable by the UniFi console. Give the Pi a static address.
WEBHOOK_PUBLIC_URL=http://192.168.1.50:8080/webhooks/unifi
WEBHOOK_PATH=/webhooks/unifi
PORT=8080

# The app creates or updates its own signed webhook subscription and retrieves
# the HMAC secret from UniFi. Set false only when registering it manually.
AUTO_REGISTER_WEBHOOK=true
WEBHOOK_NAME=unifi-access-lock
# WEBHOOK_SECRET=only-required-when-auto-registration-is-false

# Empty means every door with a DPS. Otherwise use comma-separated door IDs.
DOOR_IDS=

# Automatic mode is opt-in. Set UniFi's Lock Trigger Duration to the same value
# as NATIVE_TRIGGER_MS before enabling it. Use 1000 ms; 100 ms is too short for
# reliable webhook and API delivery.
AUTOMATIC_DPS_RELOCK_ENABLED=false
NATIVE_TRIGGER_MS=1000
LOCK_TIMEOUT_MS=60000
OPEN_LOCK_DELAY_MS=0

# Reject signed webhook requests older/newer than this many seconds.
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
UNIFI_REQUEST_TIMEOUT_MS=5000
# Optional headless override that forces monitor-only behavior even when the
# automatic setting above is true.
DRY_RUN=false

# Optional bootstrap protection. The web app can set a hashed administrator
# password instead, which is preferred over keeping plaintext here.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-12-characters
